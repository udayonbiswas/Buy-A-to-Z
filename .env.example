# --- LIVE NOTIFICATIONS SETUP ---
# To receive real-time SMS on your phone, sign up at vonage.com (Nexmo)
# and get your API Key/Secret. Add them to Settings > Secrets in AI Studio.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=BuyAtoZ

# To receive real-time Emails, use a Gmail account with 2-Step Verification
# and create an "App Password".
EMAIL_USER=
EMAIL_PASS=

# Fallback SMS provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin configuration
VITE_ADMIN_EMAIL=udayonbiswas2003@gmail.com
